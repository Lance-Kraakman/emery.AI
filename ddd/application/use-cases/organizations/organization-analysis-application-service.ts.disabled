// AIDEV-NOTE: Application service for orchestrating organizational analysis operations
// Coordinates between domain entities, Python tools, and agent execution

import { Result } from '@/ddd/domain/shared/result';
import type { Organization, OrganizationAnalysisCapabilities } from '@/ddd/domain/organizations/entities/organization';
import type { IOrganizationRepository } from '@/ddd/domain/organizations/repositories/organization-repository';
import type { IAgentRepository } from '@/ddd/domain/agents/repositories/agent-repository';
import type { ITaskRepository } from '@/ddd/domain/agents/repositories/task-repository';
import type { Agent, AgentType } from '@/ddd/domain/agents/entities/agent';
import type { Task } from '@/ddd/domain/agents/entities/task';
import { OrganizationalAnalysisBridge } from '@/lib/agents/organizational-analysis-bridge';

// AIDEV-NOTE: DTOs for organizational analysis operations
export interface InitializeAnalysisRequest {
  organizationId: number;
  analysisType: 'comprehensive' | 'focused';
  focusAreas?: string[];
  scheduledExecution?: boolean;
}

export interface MeasurementCollectionRequest {
  organizationId: number;
  agentId?: number;
  measurementCategories: string[];
  dataSources?: string[];
  automatedCollection?: boolean;
}

export interface KPICalculationRequest {
  organizationId: number;
  agentId?: number;
  kpiIds?: string[];
  recalculateAll?: boolean;
  scheduleRegular?: boolean;
}

export interface ProcessAnalysisRequest {
  organizationId: number;
  agentId?: number;
  processIds?: string[];
  analysisDepth: 'basic' | 'detailed' | 'comprehensive';
  identifyBottlenecks?: boolean;
}

export interface AnalysisResult {
  organizationId: number;
  analysisType: string;
  completedAt: Date;
  results: {
    measurements?: any;
    kpis?: any;
    processes?: any;
    insights?: string[];
    recommendations?: string[];
  };
  executedBy: {
    agentIds: number[];
    agentTypes: AgentType[];
  };
}

export class OrganizationAnalysisApplicationService {
  constructor(
    private organizationRepository: IOrganizationRepository,
    private agentRepository: IAgentRepository,
    private taskRepository: ITaskRepository
  ) {}

  /**
   * Initialize organizational analysis capabilities
   */
  async initializeAnalysisCapabilities(request: InitializeAnalysisRequest): Promise<Result<Organization>> {
    try {
      // 1. Retrieve organization
      const organization = await this.organizationRepository.findById(request.organizationId);
      if (!organization) {
        return Result.failure('Organization not found');
      }

      // 2. Create default analysis capabilities if not exists
      if (!organization.analysisCapabilities) {
        const defaultCapabilities: OrganizationAnalysisCapabilities = {
          measurementFramework: {
            categories: ['efficiency', 'quality', 'financial', 'satisfaction', 'performance'],
            definitions: [],
            kpiDefinitions: []
          },
          processDefinitions: [],
          analysisSchedule: {
            measurementCollection: 'daily',
            kpiCalculation: 'weekly',
            processAnalysis: 'monthly',
            reportGeneration: 'weekly'
          },
          improvementTracking: [],
          isSetup: true,
          setupDate: new Date().toISOString()
        };

        organization.analysisCapabilities = defaultCapabilities;
        await this.organizationRepository.save(organization);
      }

      // 3. Create or verify specialized agents exist
      await this._ensureAnalysisAgentsExist(request.organizationId);

      return Result.success(organization);
    } catch (error) {
      return Result.failure(`Failed to initialize analysis capabilities: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /**
   * Execute measurement collection using data-collector agents
   */
  async executeMeasurementCollection(request: MeasurementCollectionRequest): Promise<Result<AnalysisResult>> {
    try {
      // 1. Find or create data-collector agent
      let agent = request.agentId 
        ? await this.agentRepository.findById(request.agentId)
        : await this._findOrCreateSpecializedAgent(request.organizationId, 'data-collector');

      if (!agent) {
        return Result.failure('No suitable data-collector agent found');
      }

      // 2. Create task for measurement collection using the bridge
      const analysisInstructions = OrganizationalAnalysisBridge.createAnalysisInstructions(
        'measurement_collection',
        request.organizationId,
        { categories: request.measurementCategories }
      );

      const analysisTools = OrganizationalAnalysisBridge.createAnalysisToolsConfig(
        'data-collector',
        request.organizationId
      );

      const task = Task.create({
        agentId: agent.id,
        organizationId: request.organizationId,
        name: 'Collect Organizational Measurements',
        instructions: {
          instructions: analysisInstructions,
          tools: analysisTools,
          servers: [],
          metadata: {
            categories: request.measurementCategories,
            dataSources: request.dataSources || [],
            automatedCollection: request.automatedCollection || false,
            analysisType: 'measurement_collection',
            agentType: agent.agentType || 'data-collector'
          }
        }
      });

      await this.taskRepository.save(task);

      // 3. Return analysis result structure (task will execute asynchronously)
      const result: AnalysisResult = {
        organizationId: request.organizationId,
        analysisType: 'measurement_collection',
        completedAt: new Date(),
        results: {
          measurements: `Task ${task.shortId} created for measurement collection`
        },
        executedBy: {
          agentIds: [agent.id],
          agentTypes: [agent.agentType || 'data-collector']
        }
      };

      return Result.success(result);
    } catch (error) {
      return Result.failure(`Measurement collection failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /**
   * Execute KPI calculations using kpi-calculator agents
   */
  async executeKPICalculation(request: KPICalculationRequest): Promise<Result<AnalysisResult>> {
    try {
      // 1. Find or create kpi-calculator agent
      let agent = request.agentId 
        ? await this.agentRepository.findById(request.agentId)
        : await this._findOrCreateSpecializedAgent(request.organizationId, 'kpi-calculator');

      if (!agent) {
        return Result.failure('No suitable kpi-calculator agent found');
      }

      // 2. Create task for KPI calculation
      const task = Task.create({
        agentId: agent.id,
        organizationId: request.organizationId,
        name: 'Calculate Organizational KPIs',
        instructions: {
          instructions: request.kpiIds && request.kpiIds.length > 0
            ? `Calculate specific KPIs: ${request.kpiIds.join(', ')}. Use measurement_api tool to retrieve measurements and calculate KPI values.`
            : `Calculate all defined KPIs for the organization. Use measurement_api to get measurements and calculate all KPI values.`,
          tools: [
            { name: 'measurement_api', version: '1.0', config: { organization_id: request.organizationId.toString() } },
            { name: 'emery_database', version: '1.0', config: {} }
          ],
          servers: [],
          metadata: {
            kpiIds: request.kpiIds || [],
            recalculateAll: request.recalculateAll || false,
            scheduleRegular: request.scheduleRegular || false
          }
        }
      });

      await this.taskRepository.save(task);

      // 3. Return analysis result
      const result: AnalysisResult = {
        organizationId: request.organizationId,
        analysisType: 'kpi_calculation',
        completedAt: new Date(),
        results: {
          kpis: `Task ${task.shortId} created for KPI calculation`
        },
        executedBy: {
          agentIds: [agent.id],
          agentTypes: [agent.agentType || 'kpi-calculator']
        }
      };

      return Result.success(result);
    } catch (error) {
      return Result.failure(`KPI calculation failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /**
   * Execute process analysis using process-analyst agents
   */
  async executeProcessAnalysis(request: ProcessAnalysisRequest): Promise<Result<AnalysisResult>> {
    try {
      // 1. Find or create process-analyst agent
      let agent = request.agentId 
        ? await this.agentRepository.findById(request.agentId)
        : await this._findOrCreateSpecializedAgent(request.organizationId, 'process-analyst');

      if (!agent) {
        return Result.failure('No suitable process-analyst agent found');
      }

      // 2. Create comprehensive analysis instructions based on depth
      let analysisInstructions = '';
      let toolsRequired = [
        { name: 'process_api', version: '1.0', config: { organization_id: request.organizationId.toString() } },
        { name: 'measurement_api', version: '1.0', config: { organization_id: request.organizationId.toString() } },
        { name: 'emery_database', version: '1.0', config: {} }
      ];

      switch (request.analysisDepth) {
        case 'basic':
          analysisInstructions = 'Perform basic process analysis. Get processes using process_api and identify any obvious bottlenecks.';
          break;
        case 'detailed':
          analysisInstructions = 'Perform detailed process analysis. Use process_api to analyze bottlenecks, track performance, and identify improvement opportunities.';
          break;
        case 'comprehensive':
          analysisInstructions = 'Perform comprehensive process analysis. Use process_api for bottleneck analysis and performance tracking, measurement_api for related metrics, and create detailed improvement recommendations.';
          break;
      }

      if (request.identifyBottlenecks) {
        analysisInstructions += ' Focus on identifying and analyzing process bottlenecks with specific recommendations.';
      }

      // 3. Create task for process analysis
      const task = Task.create({
        agentId: agent.id,
        organizationId: request.organizationId,
        name: `Process Analysis - ${request.analysisDepth}`,
        instructions: {
          instructions: analysisInstructions,
          tools: toolsRequired,
          servers: [],
          metadata: {
            processIds: request.processIds || [],
            analysisDepth: request.analysisDepth,
            identifyBottlenecks: request.identifyBottlenecks || false
          }
        }
      });

      await this.taskRepository.save(task);

      // 4. Return analysis result
      const result: AnalysisResult = {
        organizationId: request.organizationId,
        analysisType: 'process_analysis',
        completedAt: new Date(),
        results: {
          processes: `Task ${task.shortId} created for ${request.analysisDepth} process analysis`
        },
        executedBy: {
          agentIds: [agent.id],
          agentTypes: [agent.agentType || 'process-analyst']
        }
      };

      return Result.success(result);
    } catch (error) {
      return Result.failure(`Process analysis failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /**
   * Execute comprehensive organizational analysis using multiple agent types
   */
  async executeComprehensiveAnalysis(request: InitializeAnalysisRequest): Promise<Result<AnalysisResult[]>> {
    try {
      const results: AnalysisResult[] = [];

      // 1. Initialize analysis capabilities
      const initResult = await this.initializeAnalysisCapabilities(request);
      if (!initResult.isSuccess) {
        return Result.failure(initResult.error);
      }

      // 2. Execute measurement collection
      const measurementResult = await this.executeMeasurementCollection({
        organizationId: request.organizationId,
        measurementCategories: ['efficiency', 'quality', 'financial', 'performance'],
        automatedCollection: true
      });

      if (measurementResult.isSuccess) {
        results.push(measurementResult.data);
      }

      // 3. Execute KPI calculations
      const kpiResult = await this.executeKPICalculation({
        organizationId: request.organizationId,
        recalculateAll: true
      });

      if (kpiResult.isSuccess) {
        results.push(kpiResult.data);
      }

      // 4. Execute process analysis
      const processResult = await this.executeProcessAnalysis({
        organizationId: request.organizationId,
        analysisDepth: 'comprehensive',
        identifyBottlenecks: true
      });

      if (processResult.isSuccess) {
        results.push(processResult.data);
      }

      return Result.success(results);
    } catch (error) {
      return Result.failure(`Comprehensive analysis failed: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  /**
   * Get organization analysis status and recent results
   */
  async getAnalysisStatus(organizationId: number): Promise<Result<{
    analysisCapabilities: OrganizationAnalysisCapabilities | null;
    availableAgents: { id: number; type: AgentType; name: string; status: string }[];
    recentTasks: { id: string; name: string; status: string; completedAt?: Date }[];
  }>> {
    try {
      // 1. Get organization with analysis capabilities
      const organization = await this.organizationRepository.findById(organizationId);
      if (!organization) {
        return Result.failure('Organization not found');
      }

      // 2. Get available analysis agents
      const agents = await this.agentRepository.findByOrganizationId(organizationId);
      const analysisAgents = agents.filter(agent => 
        ['data-collector', 'kpi-calculator', 'process-analyst', 'reporter'].includes(agent.agentType || 'general')
      );

      // 3. Get recent analysis tasks
      const recentTasks = await this.taskRepository.findByOrganizationId(organizationId, { limit: 10 });
      const analysisTasks = recentTasks.filter(task => 
        task.name.toLowerCase().includes('measurement') ||
        task.name.toLowerCase().includes('kpi') ||
        task.name.toLowerCase().includes('process') ||
        task.name.toLowerCase().includes('analysis')
      );

      const result = {
        analysisCapabilities: organization.analysisCapabilities || null,
        availableAgents: analysisAgents.map(agent => ({
          id: agent.id,
          type: agent.agentType || 'general',
          name: agent.name,
          status: agent.status
        })),
        recentTasks: analysisTasks.map(task => ({
          id: task.shortId,
          name: task.name,
          status: task.status,
          completedAt: task.completedAt
        }))
      };

      return Result.success(result);
    } catch (error) {
      return Result.failure(`Failed to get analysis status: ${error instanceof Error ? error.message : String(error)}`);
    }
  }

  // AIDEV-NOTE: Private helper methods for agent management

  /**
   * Ensure required analysis agents exist for the organization
   */
  private async _ensureAnalysisAgentsExist(organizationId: number): Promise<void> {
    const requiredAgentTypes: AgentType[] = ['data-collector', 'kpi-calculator', 'process-analyst'];
    const existingAgents = await this.agentRepository.findByOrganizationId(organizationId);
    
    for (const agentType of requiredAgentTypes) {
      const hasAgentOfType = existingAgents.some(agent => agent.agentType === agentType);
      if (!hasAgentOfType) {
        await this._createSpecializedAgent(organizationId, agentType);
      }
    }
  }

  /**
   * Find existing or create new specialized agent
   */
  private async _findOrCreateSpecializedAgent(organizationId: number, agentType: AgentType): Promise<Agent | null> {
    const existingAgents = await this.agentRepository.findByOrganizationId(organizationId);
    const specializedAgent = existingAgents.find(agent => agent.agentType === agentType);
    
    if (specializedAgent) {
      return specializedAgent;
    }

    return await this._createSpecializedAgent(organizationId, agentType);
  }

  /**
   * Create a new specialized agent for organizational analysis
   */
  private async _createSpecializedAgent(organizationId: number, agentType: AgentType): Promise<Agent> {
    // AIDEV-NOTE: Agent creation logic would integrate with existing agent creation system
    // For now, this is a placeholder that shows the structure
    
    const agentNames = {
      'data-collector': 'Data Collection Agent',
      'kpi-calculator': 'KPI Calculator Agent', 
      'process-analyst': 'Process Analysis Agent',
      'reporter': 'Reporting Agent',
      'coordinator': 'Coordination Agent',
      'monitor': 'Monitoring Agent',
      'general': 'General Purpose Agent'
    };

    const agent = Agent.create({
      organizationId,
      name: agentNames[agentType],
      role: 'assistant',
      description: `Specialized ${agentType} for organizational analysis`,
      persona: `You are a ${agentType} specializing in organizational analysis and optimization.`,
      agentType,
      specialization: {
        domainExpertise: [`${agentType}-operations`, 'organizational-analysis'],
        analysisCapabilities: ['data-processing', 'insight-generation'],
        measurementCategories: ['efficiency', 'quality', 'performance']
      },
      status: 'active'
    });

    await this.agentRepository.save(agent);
    return agent;
  }
}