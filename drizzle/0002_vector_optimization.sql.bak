-- Vector Storage Optimization for Multi-Tenant RAG System
-- Optimizes vector search performance with organization-scoped indexes

-- =============================================================================
-- STEP 1: CREATE OPTIMIZED VECTOR SEARCH INDEXES
-- =============================================================================

-- Fast organization filtering (B-tree index) before vector search
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_org_id_fast 
    ON rag_documents(organization_id);

-- Vector indexes for similarity search within pre-filtered results
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_embedding_cosine 
    ON rag_documents USING ivfflat (embedding vector_cosine_ops) 
    WITH (lists = 100);

CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_embedding_l2 
    ON rag_documents USING ivfflat (embedding) 
    WITH (lists = 100);

-- =============================================================================
-- STEP 2: CREATE PARTIAL INDEXES FOR COMMON QUERY PATTERNS
-- =============================================================================

-- Partial indexes for active documents with embeddings
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_org_with_embedding 
    ON rag_documents(organization_id, rag_index_id) 
    WHERE embedding IS NOT NULL;

-- Index for source-type filtering within organization
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_org_source_type 
    ON rag_documents(organization_id, source_type);

-- Index for recently indexed content
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_org_recent 
    ON rag_documents(organization_id, indexed_at DESC);

-- Content hash lookup within organization
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_documents_org_content_hash 
    ON rag_documents(organization_id, content_hash);

-- =============================================================================
-- STEP 3: OPTIMIZE RAG_QUERY_LOGS FOR ANALYTICS
-- =============================================================================

-- Fast query lookup within organization
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_query_logs_org_time 
    ON rag_query_logs(organization_id, created_at DESC);

-- Agent-specific query analytics
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_query_logs_org_agent 
    ON rag_query_logs(organization_id, agent_id) 
    WHERE agent_id IS NOT NULL;

-- User-specific query analytics  
CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_rag_query_logs_org_user 
    ON rag_query_logs(organization_id, user_id) 
    WHERE user_id IS NOT NULL;

-- =============================================================================
-- STEP 4: CREATE OPTIMIZED VECTOR SEARCH FUNCTION
-- =============================================================================

-- Function for organization-scoped vector similarity search
CREATE OR REPLACE FUNCTION search_rag_documents_by_organization(
    org_id integer,
    query_embedding vector(1024),
    similarity_threshold float DEFAULT 0.5,
    max_results integer DEFAULT 10
)
RETURNS TABLE (
    id uuid,
    rag_index_id uuid,
    source_type text,
    source_id text,
    source_name text,
    title text,
    content text,
    metadata jsonb,
    similarity_score float
) AS $$
BEGIN
    RETURN QUERY
    SELECT 
        rd.id,
        rd.rag_index_id,
        rd.source_type,
        rd.source_id,
        rd.source_name,
        rd.title,
        rd.content,
        rd.metadata,
        (1 - (rd.embedding <=> query_embedding)) as similarity_score
    FROM rag_documents rd
    WHERE rd.organization_id = org_id
      AND rd.embedding IS NOT NULL
      AND (1 - (rd.embedding <=> query_embedding)) >= similarity_threshold
    ORDER BY rd.embedding <=> query_embedding
    LIMIT max_results;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- =============================================================================
-- STEP 5: CREATE FUNCTION FOR RAG STATISTICS
-- =============================================================================

-- Function to get vector statistics for an organization
CREATE OR REPLACE FUNCTION get_rag_stats_by_organization(org_id integer)
RETURNS TABLE (
    total_documents bigint,
    documents_with_embeddings bigint,
    avg_content_length float,
    last_indexed_at timestamp
) AS $$
BEGIN
    RETURN QUERY
    SELECT 
        COUNT(*) as total_documents,
        COUNT(embedding) as documents_with_embeddings,
        AVG(LENGTH(content))::float as avg_content_length,
        MAX(indexed_at) as last_indexed_at
    FROM rag_documents rd
    WHERE rd.organization_id = org_id;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- =============================================================================
-- STEP 6: CREATE TRIGGERS FOR AUTOMATIC ORGANIZATION_ID MAINTENANCE
-- =============================================================================

-- Function to automatically set organization_id on rag_documents
CREATE OR REPLACE FUNCTION set_rag_document_organization_id()
RETURNS TRIGGER AS $$
BEGIN
    -- Get organization_id from the rag_index
    SELECT organization_id INTO NEW.organization_id
    FROM rag_indexes
    WHERE id = NEW.rag_index_id;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger to auto-populate organization_id on insert
CREATE TRIGGER set_rag_document_org_id_trigger
    BEFORE INSERT ON rag_documents
    FOR EACH ROW
    EXECUTE FUNCTION set_rag_document_organization_id();

-- Function to automatically set organization_id on rag_query_logs
CREATE OR REPLACE FUNCTION set_rag_query_log_organization_id()
RETURNS TRIGGER AS $$
BEGIN
    -- Get organization_id from the rag_index
    SELECT organization_id INTO NEW.organization_id
    FROM rag_indexes
    WHERE id = NEW.rag_index_id;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger to auto-populate organization_id on insert
CREATE TRIGGER set_rag_query_log_org_id_trigger
    BEFORE INSERT ON rag_query_logs
    FOR EACH ROW
    EXECUTE FUNCTION set_rag_query_log_organization_id();

-- =============================================================================
-- STEP 7: CREATE VIEW FOR RAG ANALYTICS
-- =============================================================================

-- View for RAG analytics within organization context
CREATE OR REPLACE VIEW rag_organization_analytics AS
SELECT 
    ri.organization_id,
    ri.id as rag_index_id,
    ri.name as index_name,
    COUNT(rd.id) as document_count,
    COUNT(rd.embedding) as embedded_document_count,
    AVG(LENGTH(rd.content)) as avg_content_length,
    MAX(rd.indexed_at) as last_indexed_at,
    COUNT(DISTINCT rd.source_type) as unique_source_types
FROM rag_indexes ri
LEFT JOIN rag_documents rd ON ri.id = rd.rag_index_id
GROUP BY ri.organization_id, ri.id, ri.name;

-- =============================================================================
-- STEP 8: GRANT PERMISSIONS
-- =============================================================================

-- Grant execute permissions on optimization functions
GRANT EXECUTE ON FUNCTION search_rag_documents_by_organization(integer, vector(1024), float, integer) TO PUBLIC;
GRANT EXECUTE ON FUNCTION get_rag_stats_by_organization(integer) TO PUBLIC;

-- Grant access to the analytics view
GRANT SELECT ON rag_organization_analytics TO PUBLIC;

-- =============================================================================
-- STEP 9: ANALYZE TABLES FOR OPTIMAL QUERY PLANNING
-- =============================================================================

ANALYZE rag_documents;
ANALYZE rag_query_logs;
ANALYZE rag_indexes;