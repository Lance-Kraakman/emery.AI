DATABASE_URL=postgresql://postgres:dashlet@localhost:5433/emery
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Auth Providers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# S3 Configuration (MinIO for local development)
AWS_ACCESS_KEY_ID=emery
AWS_SECRET_ACCESS_KEY=dashlet123
AWS_REGION=us-east-1
S3_BUCKET_NAME=emery-files
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Pipedream settings
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_API_KEY=

# Hugging Face integration (required for AI features)
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-hugging-face-token

# gRPC Server Configuration
# Main server for Next.js chat processing
WORKER_ADDRESS=localhost:50051
# Tools server for Python tool operations (prevents circular dependency)
GRPC_TOOLS_ADDRESS=localhost:50052

# Resend
RESEND_API_KEY=***REMOVED***

# Stripe Billing Configuration
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here

# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

#admin email to set enterprise customers
ADMIN_EMAILS=lancekraakman@outlook.com

# Pro tier product/price IDs (create in Stripe dashboard)
STRIPE_PRO_PRODUCT_ID=prod_your-pro-product-id
STRIPE_PRO_PRICE_ID_MONTHLY=price_your-pro-monthly-price-id
STRIPE_PRO_PRICE_ID_YEARLY=price_your-pro-yearly-price-id

# Max tier product/price IDs (create in Stripe dashboard)
STRIPE_MAX_PRODUCT_ID=prod_your-max-product-id
STRIPE_MAX_PRICE_ID_MONTHLY=price_your-max-monthly-price-id
STRIPE_MAX_PRICE_ID_YEARLY=price_your-max-yearly-price-id

# Enterprise tier product ID (prices created dynamically per customer)
STRIPE_ENTERPRISE_PRODUCT_ID=prod_your-enterprise-product-id

# Superuser Admin Access
# Comma-separated list of emails with admin/superuser privileges
# Used for Enterprise provisioning and admin-only features
ADMIN_EMAILS=your@email.com,cofounder@email.com
