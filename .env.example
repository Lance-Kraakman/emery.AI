# S3 Configuration (MinIO for local development)
AWS_ACCESS_KEY_ID=orchastrate
AWS_SECRET_ACCESS_KEY=dashlet123
AWS_REGION=us-east-1
S3_BUCKET_NAME=orchastrate-files
