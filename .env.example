DATABASE_URL=postgresql://postgres:dashlet@localhost:5433/emery
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Auth Providers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# S3 Configuration (MinIO for local development)
AWS_ACCESS_KEY_ID=emery
AWS_SECRET_ACCESS_KEY=dashlet123
AWS_REGION=us-east-1
S3_BUCKET_NAME=emery-files
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Pipedream settings
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_API_KEY=

# Hugging Face integration (required for AI features)
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-hugging-face-token

# Email authentication (for testing with seeded users)
# For development: use MailHog or similar SMTP testing server
# Install: brew install mailhog && mailhog (runs on localhost:1025)
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@emery.dev