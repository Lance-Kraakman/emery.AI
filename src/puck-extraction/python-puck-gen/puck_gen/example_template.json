      }
    },
    {
      "type": "RichText",
      "props": {
        "id": "RichText-6c05b320-7f09-4413-a5e1-c6aad94dbe7c",
        "state": {
          "root": {
            "type": "root",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "This consultation sought community input on three models for the future delivery of water services across four South Island councils - Gore District Council, Waitaki District Council, Central Otago District Council and Clutha District Council - under the banner of Southern Water Done Well.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 0
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 0
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "The consultation was conducted jointly, with each SWDW council also presenting information specific to their communities and receiving feedback from their communities. ",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 0
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 0
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Respondents were presented with three organisational options:",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 0
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Option 1:",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 1,
                    "version": 1
                  },
                  {
                    "mode": "normal",
                    "text": " Jointly owned Council Controlled Organisation (CCO). This was the preferred option across all SWDW councils",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 1
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Option 2:",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 1,
                    "version": 1
                  },
                  {
                    "mode": "normal",
                    "text": " Stand-alone Council Controlled Organisation",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textStyle": "",
                "textFormat": 1
              },
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Option 3:",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 1,
                    "version": 1
                  },
                  {
                    "mode": "normal",
                    "text": " In-house Business Unit",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
