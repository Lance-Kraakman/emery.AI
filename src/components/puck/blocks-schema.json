{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "Puck block definitions for AI agent documentation. Manually maintained - update when blocks change.",

  "system": {
    "themes": {
      "description": "Theme stored as JSON in database, converted to CSS variables at render. See ThemeConfig value object.",
      "source": "src/ddd/domain/puck/value-objects/theme-config.ts",
      "storage": {
        "appLevel": "puckApps.themeConfig (JSONB)",
        "pageLevel": "puckPages.themeConfig (JSONB) - overrides app theme"
      },
      "cssVariables": {
        "colors": [
          "--theme-primary",
          "--theme-secondary",
          "--theme-background",
          "--theme-surface",
          "--theme-text",
          "--theme-text-muted",
          "--theme-border",
          "--theme-link",
          "--theme-success",
          "--theme-warning",
          "--theme-error"
        ],
        "typography": [
          "--theme-font-family",
          "--theme-font-size",
          "--theme-heading-font-weight",
          "--theme-heading-color",
          "--theme-font-xs",
          "--theme-font-sm",
          "--theme-font-base",
          "--theme-font-lg",
          "--theme-font-xl",
          "--theme-font-2xl",
          "--theme-font-3xl",
          "--theme-font-4xl",
          "--theme-font-5xl"
        ],
        "spacing": [
          "--theme-spacing-unit",
          "--theme-spacing-scale",
          "--theme-padding-top",
          "--theme-padding-right",
          "--theme-padding-bottom",
          "--theme-padding-left",
          "--theme-margin-top",
          "--theme-margin-right",
          "--theme-margin-bottom",
          "--theme-margin-left"
        ],
        "borders": [
          "--theme-border-radius",
          "--theme-border-radius-tl",
          "--theme-border-radius-tr",
          "--theme-border-radius-br",
          "--theme-border-radius-bl",
          "--theme-border-width"
        ],
        "alignment": [
          "--theme-text-align",
          "--theme-justify-content",
          "--theme-align-items",
          "--theme-justify-items",
          "--theme-align-content"
        ]
      },
      "configStructure": {
        "colors": {
          "primary": "#2563eb",
          "secondary": "#64748b",
          "background": "#ffffff",
          "surface": "#f8fafc",
          "text": "#1e293b",
          "textMuted": "#64748b",
          "border": "#e2e8f0",
          "link": "#2563eb",
          "success": "#10b981",
          "warning": "#f59e0b",
          "error": "#ef4444"
        },
        "typography": {
          "fontFamily": "Inter, system-ui, sans-serif",
          "fontSize": "16px",
          "headingFontWeight": 600
        },
        "spacing": {
          "unit": "0.25rem",
          "scale": 1.5,
          "defaultPadding": { "top": 0, "right": 0, "bottom": 0, "left": 0, "linked": true },
          "defaultMargin": { "top": 0, "right": 0, "bottom": 0, "left": 0, "linked": true }
        },
        "borders": {
          "radius": { "topLeft": 2, "topRight": 2, "bottomRight": 2, "bottomLeft": 2, "linked": true },
          "width": "1px"
        },
        "alignment": {
          "defaultTextAlign": "left",
          "defaultJustifyContent": "start",
          "defaultAlignItems": "start"
        }
      }
    },
    "pageVariables": {
      "description": "Dynamic values available in blocks via variable templates",
      "syntax": "{params.varName}",
      "examples": [
        "{params.product_id} - URL path parameter",
        "{params.user_id} - Query string parameter"
      ],
      "supportedBlocks": ["TextField", "NumberField", "Button", "LinkBlock"],
      "usage": "Use in text/label fields for dynamic content based on URL parameters"
    },
    "dataBinding": {
      "description": "DataBlock provides row context to child field blocks",
      "modes": {
        "single": "Single row detail view - uses filter to select one row",
        "list": "Repeating items - iterates over multiple rows"
      },
      "flow": [
        "1. DataBlock queries view with filters",
        "2. DataBlock provides DataLayoutContext (fields) + RowDataContext (data)",
        "3. Child field blocks use context to display row values"
      ],
      "note": "Field blocks (TextField, NumberField, etc.) MUST be inside DataBlock to access row data"
    }
  },

  "categories": {
    "layout": {
      "title": "Layout",
      "description": "Structural containers for organizing content",
      "blocks": ["Grid", "Flex", "Container", "Space", "Divider"]
    },
    "typography": {
      "title": "Typography",
      "description": "Text display components",
      "blocks": ["Heading", "Text"]
    },
    "interactive": {
      "title": "Actions",
      "description": "Clickable elements with configurable actions",
      "blocks": ["Button", "LinkBlock"]
    },
    "authentication": {
      "title": "Authentication",
      "description": "User auth components",
      "blocks": ["LoginBlock", "SignOutBlock"]
    },
    "data": {
      "title": "Data",
      "description": "Data-aware blocks that connect to database tables/views",
      "blocks": ["DataBlock", "TableBlock", "MetricBlock", "ChartBlock", "FormBlock"]
    },
    "fields": {
      "title": "Fields",
      "description": "Display individual field values from DataBlock context",
      "blocks": ["TextField", "NumberField", "BooleanField", "DateField", "SelectField", "ImageField", "FileField", "DocumentField", "RelationField", "LinkField"],
      "note": "MUST be inside a DataBlock to access row data"
    },
    "logic": {
      "title": "Logic",
      "description": "Conditional rendering",
      "blocks": ["ConditionalBlock"]
    },
    "content": {
      "title": "Content",
      "description": "Rich content blocks",
      "blocks": ["EditorBlock", "MarkdownBlock"]
    },
    "structure": {
      "title": "Page Structure",
      "description": "Page-level layout components",
      "blocks": ["HeaderBlock", "FooterBlock"]
    },
    "templates": {
      "title": "Templates",
      "description": "Pre-built component combinations",
      "blocks": ["Template", "Card", "Hero", "Logos", "Stats"]
    }
  },

  "blocks": {
    "Button": {
      "description": "CTA button with configurable actions",
      "props": {
        "label": { "type": "string", "description": "Button text (supports {fieldName} variables)" },
        "variant": { "type": "enum", "options": ["primary", "secondary"], "default": "primary" },
        "actions": { "type": "array", "description": "Actions to execute on click" }
      }
    },
    "LinkBlock": {
      "description": "Navigation link with variable support",
      "props": {
        "label": { "type": "string", "description": "Link text (supports {fieldName} variables)" },
        "href": { "type": "string", "description": "URL (supports {params.x} variables)" }
      }
    },
    "Heading": {
      "description": "Section heading h1-h6",
      "props": {
        "text": { "type": "string" },
        "level": { "type": "enum", "options": ["h1", "h2", "h3", "h4", "h5", "h6"], "default": "h2" },
        "align": { "type": "enum", "options": ["left", "center", "right"], "default": "left" }
      }
    },
    "Text": {
      "description": "Rich text paragraph content",
      "props": {
        "text": { "type": "string" },
        "align": { "type": "enum", "options": ["left", "center", "right"], "default": "left" }
      }
    },
    "Grid": {
      "description": "CSS grid layout container",
      "props": {
        "columns": { "type": "number", "default": 2 },
        "gap": { "type": "number", "default": 4 }
      },
      "slots": ["children"]
    },
    "Flex": {
      "description": "Flexbox container",
      "props": {
        "direction": { "type": "enum", "options": ["row", "column"], "default": "row" },
        "gap": { "type": "number", "default": 4 },
        "align": { "type": "enum", "options": ["start", "center", "end", "stretch"], "default": "start" },
        "justify": { "type": "enum", "options": ["start", "center", "end", "between", "around"], "default": "start" }
      },
      "slots": ["children"]
    },
    "Container": {
      "description": "Content wrapper with max-width",
      "props": {
        "maxWidth": { "type": "enum", "options": ["sm", "md", "lg", "xl", "full"], "default": "lg" },
        "padding": { "type": "enum", "options": ["none", "sm", "md", "lg"], "default": "md" }
      },
      "slots": ["children"]
    },
    "Space": {
      "description": "Vertical spacing element",
      "props": {
        "size": { "type": "enum", "options": ["xs", "sm", "md", "lg", "xl"], "default": "md" }
      }
    },
    "Divider": {
      "description": "Horizontal divider line",
      "props": {
        "color": { "type": "string", "description": "CSS color value" }
      }
    },
    "DataBlock": {
      "description": "Data container that provides row context to children. Required parent for Field blocks.",
      "props": {
        "viewId": { "type": "number", "description": "Database view to query", "required": true },
        "mode": { "type": "enum", "options": ["single", "list"], "default": "single" },
        "filters": { "type": "array", "description": "Row filters [{field, operator, value}]. Use {params.x} for dynamic values" },
        "sorts": { "type": "array", "description": "Sort configuration [{field, direction}]" },
        "limit": { "type": "number", "description": "Max rows for list mode" }
      },
      "slots": ["children"],
      "note": "Children can be Field blocks to display row data"
    },
    "TableBlock": {
      "description": "Display tabular data from a view",
      "props": {
        "viewId": { "type": "number", "required": true },
        "columns": { "type": "array", "description": "Column configuration" },
        "pageSize": { "type": "number", "default": 10 }
      }
    },
    "MetricBlock": {
      "description": "Display a single metric/KPI value",
      "props": {
        "viewId": { "type": "number" },
        "fieldId": { "type": "number" },
        "label": { "type": "string" },
        "format": { "type": "enum", "options": ["number", "currency", "percent"] }
      }
    },
    "ChartBlock": {
      "description": "Data visualization chart",
      "props": {
        "viewId": { "type": "number" },
        "chartType": { "type": "enum", "options": ["bar", "line", "pie", "area"] },
        "xField": { "type": "number" },
        "yField": { "type": "number" }
      }
    },
    "FormBlock": {
      "description": "Input form for creating/editing rows",
      "props": {
        "tableId": { "type": "number", "required": true },
        "fields": { "type": "array", "description": "Field IDs to include in form" },
        "mode": { "type": "enum", "options": ["create", "edit"], "default": "create" },
        "submitLabel": { "type": "string", "default": "Submit" }
      }
    },
    "TextField": {
      "description": "Display text field value from DataBlock context",
      "props": {
        "fieldId": { "type": "number", "description": "Field to display", "required": true },
        "label": { "type": "string", "description": "Optional label" },
        "fallback": { "type": "string", "description": "Value if field is empty" },
        "labelPosition": { "type": "enum", "options": ["top", "left", "none"], "default": "top" }
      },
      "requires": "DataBlock parent"
    },
    "NumberField": {
      "description": "Display number field with formatting",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" },
        "format": { "type": "enum", "options": ["number", "currency", "percent"] }
      },
      "requires": "DataBlock parent"
    },
    "BooleanField": {
      "description": "Display boolean as checkbox/toggle",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" }
      },
      "requires": "DataBlock parent"
    },
    "DateField": {
      "description": "Display date field with formatting",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" },
        "format": { "type": "string", "description": "Date format string" }
      },
      "requires": "DataBlock parent"
    },
    "SelectField": {
      "description": "Display select/dropdown field value",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" }
      },
      "requires": "DataBlock parent"
    },
    "ImageField": {
      "description": "Display image from field",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "alt": { "type": "string" },
        "size": { "type": "enum", "options": ["sm", "md", "lg", "full"] }
      },
      "requires": "DataBlock parent"
    },
    "FileField": {
      "description": "Display file download link",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" }
      },
      "requires": "DataBlock parent"
    },
    "DocumentField": {
      "description": "Display document field",
      "props": {
        "fieldId": { "type": "number", "required": true }
      },
      "requires": "DataBlock parent"
    },
    "RelationField": {
      "description": "Display linked record",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "displayField": { "type": "number", "description": "Field to display from related record" }
      },
      "requires": "DataBlock parent"
    },
    "LinkField": {
      "description": "Display URL as clickable link",
      "props": {
        "fieldId": { "type": "number", "required": true },
        "label": { "type": "string" }
      },
      "requires": "DataBlock parent"
    },
    "ConditionalBlock": {
      "description": "Show/hide content based on conditions",
      "props": {
        "condition": { "type": "string", "description": "Condition expression" },
        "showIf": { "type": "boolean", "default": true }
      },
      "slots": ["children"]
    },
    "EditorBlock": {
      "description": "Rich text editor content",
      "props": {
        "content": { "type": "string", "description": "HTML content" }
      }
    },
    "MarkdownBlock": {
      "description": "Markdown content renderer",
      "props": {
        "content": { "type": "string", "description": "Markdown text" }
      }
    },
    "LoginBlock": {
      "description": "Sign in / sign up form",
      "props": {
        "mode": { "type": "enum", "options": ["signin", "signup", "both"], "default": "both" },
        "redirectUrl": { "type": "string", "description": "URL after auth" }
      }
    },
    "SignOutBlock": {
      "description": "Sign out button",
      "props": {
        "label": { "type": "string", "default": "Sign Out" },
        "redirectUrl": { "type": "string" }
      }
    },
    "HeaderBlock": {
      "description": "Page header with navigation",
      "props": {
        "logo": { "type": "string", "description": "Logo URL" },
        "title": { "type": "string" },
        "showNav": { "type": "boolean", "default": true }
      }
    },
    "FooterBlock": {
      "description": "Page footer",
      "props": {
        "text": { "type": "string" },
        "links": { "type": "array" }
      }
    },
    "Hero": {
      "description": "Hero section with title, description, and CTA",
      "props": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "buttons": { "type": "array" },
        "backgroundImage": { "type": "string" }
      }
    },
    "Card": {
      "description": "Card container with optional header/footer",
      "props": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "slots": ["children"]
    },
    "Logos": {
      "description": "Logo grid/carousel",
      "props": {
        "logos": { "type": "array", "description": "[{src, alt, href}]" }
      }
    },
    "Stats": {
      "description": "Statistics display grid",
      "props": {
        "items": { "type": "array", "description": "[{value, label}]" }
      }
    }
  }
}
