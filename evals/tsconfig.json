{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["../src/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["providers/**/*.ts", "assertions/**/*.ts"],
  "exclude": ["node_modules"]
}
