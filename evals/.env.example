# Emery Eval Environment Variables
# Copy to .env and fill in your values

# Required: Your user API key (user_xxx format)
EMERY_API_KEY=user_your_api_key_here

# API base URL (default: http://localhost:3002)
EMERY_BASE_URL=http://localhost:3002

# ============================================
# Test fixtures - IDs for different test types
# ============================================

# Layer 1: CRUD tests
TEST_TABLE_ID=1
TEST_DATABASE_ID=1

# Layer 2-3: Agent tests
TEST_AGENT_ID=1

# Layer 3-4: Specific agent types
SCHEMA_BUILDER_AGENT_ID=2
SKILL_BUILDER_AGENT_ID=3
