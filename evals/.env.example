# Emery Eval Environment Variables
# Copy to .env and fill in your values

# Required: Your user API key (user_xxx format)
EMERY_API_KEY=user_your_api_key_here

# API base URL (default: http://localhost:3002)
EMERY_BASE_URL=http://localhost:3002

# ============================================
# Test fixtures - IDs for different test types
# ============================================

# Layer 1: CRUD tests (works with any valid IDs)
TEST_TABLE_ID=1
TEST_DATABASE_ID=1

# Layer 2-4: Agent tests
# IMPORTANT: These agent IDs must be owned by the user whose API key you're using.
# The test user must have permission to execute these agents.
# Create agents via the UI or API and set the IDs here.
TEST_AGENT_ID=1
SCHEMA_BUILDER_AGENT_ID=1  # Agent with schema_builder role
SKILL_BUILDER_AGENT_ID=1   # Agent with skill_builder role
