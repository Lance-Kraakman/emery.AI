# Emery Eval Environment Variables
# Copy to .env and fill in your values

# Required: Your user API key (user_xxx format)
EMERY_API_KEY=user_your_api_key_here

# API base URL (default: http://localhost:3002)
EMERY_BASE_URL=http://localhost:3002

# Test fixtures - IDs of existing table/agent to test against
TEST_TABLE_ID=1
TEST_AGENT_ID=1
