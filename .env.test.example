# Test environment configuration
# Copy to .env.test and customize for your testing needs

# Agent Worker Configuration
AGENT_WORKER_VERSION=latest
TEST_ORGANIZATION_ID=test-org

# AI Model Testing (optional - only needed for real AI execution tests)
HF_TOKEN=your_huggingface_token_here
GEMINI_API_KEY=your_gemeni_api_key

# Database Configuration (automatically set by docker-compose.test.yml)
DATABASE_URL=postgresql://postgres:testpass@localhost:5434/emery_test

# Test Service Ports (to avoid conflicts with development)
TEST_DB_PORT=5434
TEST_AGENT_PORT=50051
TEST_MINIO_PORT=9002
TEST_FRONTEND_PORT=3001

# Test Data Configuration
S3_BUCKET_NAME=emery-test
ENVIRONMENT=test

# NextAuth for frontend testing (if using --full-integration)
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=test-secret-key-for-testing-only