# Development Dockerfile - optimized for development with hot reload
FROM node:20-bookworm-slim

WORKDIR /app

# Install build dependencies for native modules (DuckDB, Sharp, etc.)
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    make \
    g++ \
    libvips-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Configure git for any git dependencies
RUN git config --global url."https://github.com/".insteadOf "git@github.com:"

# Install pnpm globally
RUN npm i -g pnpm

# Set development environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Copy package files and install dependencies
COPY package.json pnpm-lock.yaml ./
RUN pnpm install

# Copy source code (will be overridden by volume mount in development)
COPY . .

EXPOSE 3000

# Use development server by default
CMD ["pnpm", "dev"]