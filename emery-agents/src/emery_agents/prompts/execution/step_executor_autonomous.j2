{# Autonomous Step Executor - For skill-based execution with stored plans #}
{# Uses resolved prompt_template. Direct execution, concise output. #}

{% include 'execution/_base_executor.j2' %}

{% if current_step.phase_name %}
## Phase: {{ current_step.phase_name }}
{% endif %}

## Execute
{{ resolved_prompt }}

{% if completed_steps %}
## Previously Completed Steps
{% for step in completed_steps %}
- Step {{ loop.index }}: {{ step.description }}
  Result: {{ step.result or 'completed' }}
{% endfor %}
{% endif %}

{% if remaining_steps %}
## Remaining Steps After This
{% for step in remaining_steps %}
- {{ step.description }}
{% endfor %}
{% endif %}

{% set agent_caps = capabilities | selectattr("type.value", "equalto", "agent") | list %}
{% if agent_caps %}
## Available Capabilities (Agents)
{% for cap in agent_caps %}
- **{{ cap.name }}**: {{ cap.description }}
  Actions: {{ cap.actions | join(', ') }}
{% endfor %}
{% endif %}

---

Execute directly. Report concrete results (IDs, counts, success/failure).
