{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "field_crud",
  "description": "Manage table columns (fields) - create, list, delete",
  "operations": {
    "list_fields": {
      "description": "List all columns in a table",
      "inputs": {
        "table_id": {
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "Table UUID"
        }
      },
      "outputs": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "integer"},
              "name": {"type": "string"},
              "type": {"type": "string", "enum": ["text", "number", "date", "boolean", "single-select", "multi-select", "relation", "email", "phone", "url", "tiptap_editor"]}
            }
          }
        }
      }
    },
    "create_field": {
      "description": "Add a new column to a table",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "field_name": {"type": "string", "required": true},
        "field_type": {
          "type": "string",
          "required": true,
          "enum": ["text", "number", "date", "boolean", "single-select", "multi-select", "relation", "email", "phone", "url", "tiptap_editor"]
        },
        "field_required": {"type": "boolean", "default": false},
        "related_table_id": {
          "type": "string",
          "format": "uuid",
          "description": "Required when field_type is 'relation'"
        },
        "field_config": {
          "type": "object",
          "description": "Required for single-select/multi-select",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {"type": "string"},
                  "color": {"type": "string"}
                }
              }
            }
          }
        }
      },
      "outputs": {
        "success": {"type": "boolean"},
        "field_id": {"type": "integer"},
        "field": {"type": "object"}
      },
      "errors": ["TABLE_NOT_FOUND", "FIELD_EXISTS", "INVALID_TYPE", "MISSING_CONFIG"]
    },
    "delete_field": {
      "description": "Remove a column from a table",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "field_id": {"type": "integer", "required": true}
      },
      "outputs": {
        "success": {"type": "boolean"}
      },
      "errors": ["TABLE_NOT_FOUND", "FIELD_NOT_FOUND"]
    }
  }
}
