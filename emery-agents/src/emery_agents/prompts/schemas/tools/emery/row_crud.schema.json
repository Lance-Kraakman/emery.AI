{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "row_crud",
  "description": "Manage table rows - create, read, update, delete",
  "operations": {
    "list_rows": {
      "description": "List rows from a table with optional filtering",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {"type": "string"},
              "operator": {"type": "string", "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "contains", "starts_with", "ends_with"]},
              "value": {}
            }
          }
        },
        "limit": {"type": "integer", "default": 100},
        "offset": {"type": "integer", "default": 0}
      },
      "outputs": {
        "rows": {
          "type": "array",
          "items": {"type": "object"}
        },
        "total_count": {"type": "integer"}
      }
    },
    "get_row": {
      "description": "Get a single row by ID",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "row_id": {"type": "integer", "required": true}
      },
      "outputs": {
        "row": {"type": "object"}
      },
      "errors": ["TABLE_NOT_FOUND", "ROW_NOT_FOUND"]
    },
    "create_row": {
      "description": "Create a new row in a table",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "data": {"type": "object", "required": true, "description": "Field name to value mapping"}
      },
      "outputs": {
        "success": {"type": "boolean"},
        "row_id": {"type": "integer"},
        "row": {"type": "object"}
      },
      "errors": ["TABLE_NOT_FOUND", "VALIDATION_ERROR", "MISSING_REQUIRED_FIELD"]
    },
    "update_row": {
      "description": "Update an existing row",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "row_id": {"type": "integer", "required": true},
        "data": {"type": "object", "required": true, "description": "Field name to value mapping"}
      },
      "outputs": {
        "success": {"type": "boolean"},
        "row": {"type": "object"}
      },
      "errors": ["TABLE_NOT_FOUND", "ROW_NOT_FOUND", "VALIDATION_ERROR"]
    },
    "delete_row": {
      "description": "Delete a row from a table",
      "inputs": {
        "table_id": {"type": "string", "format": "uuid", "required": true},
        "row_id": {"type": "integer", "required": true}
      },
      "outputs": {
        "success": {"type": "boolean"}
      },
      "errors": ["TABLE_NOT_FOUND", "ROW_NOT_FOUND"]
    }
  }
}
