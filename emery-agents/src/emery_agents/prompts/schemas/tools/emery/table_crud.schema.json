{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "table_crud",
  "description": "Manage database tables - create, list, delete",
  "operations": {
    "list_tables": {
      "description": "List all tables in a database",
      "inputs": {
        "database_id": {"type": "string", "format": "uuid", "required": true}
      },
      "outputs": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "format": "uuid"},
              "name": {"type": "string"},
              "field_count": {"type": "integer"},
              "row_count": {"type": "integer"}
            }
          }
        }
      }
    },
    "create_table": {
      "description": "Create a new table in a database",
      "inputs": {
        "database_id": {"type": "string", "format": "uuid", "required": true},
        "table_name": {"type": "string", "required": true},
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "required": true},
              "type": {"type": "string", "required": true},
              "required": {"type": "boolean", "default": false}
            }
          }
        }
      },
      "outputs": {
        "success": {"type": "boolean"},
        "table_id": {"type": "string", "format": "uuid"},
        "table": {"type": "object"}
      },
      "errors": ["DATABASE_NOT_FOUND", "TABLE_EXISTS", "INVALID_FIELD_TYPE"]
    },
    "delete_table": {
      "description": "Delete a table from a database",
      "inputs": {
        "database_id": {"type": "string", "format": "uuid", "required": true},
        "table_id": {"type": "string", "format": "uuid", "required": true}
      },
      "outputs": {
        "success": {"type": "boolean"}
      },
      "errors": ["DATABASE_NOT_FOUND", "TABLE_NOT_FOUND"]
    }
  }
}
