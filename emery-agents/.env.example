# Python gRPC Worker Configuration
# Main server for Next.js chat processing
WORKER_ADDRESS=localhost:50051

# Next.js API URL (for workspace API calls)
# In development: http://localhost:3000
# In Docker: http://host.docker.internal:3000 or use service name
NEXTJS_BASE_URL=http://localhost:3000

# Tools server for Python tool operations (prevents circular dependency)
GRPC_TOOLS_ADDRESS=localhost:50052

# gRPC Thread Pool Configuration
# Maximum worker threads for chat server (default: 20)
GRPC_CHAT_MAX_WORKERS=20
# Maximum worker threads for table server (default: 15)
GRPC_TABLE_MAX_WORKERS=15

# Organization ID
ORGANIZATION_ID=default

# Hugging Face token (required for AI features)
HF_TOKEN=hf_your-hugging-face-token

# S3/MinIO Configuration (inherited from main .env)
AWS_ACCESS_KEY_ID=emery
AWS_SECRET_ACCESS_KEY=dashlet123
AWS_REGION=us-east-1
S3_BUCKET_NAME=enhancd-files
S3_ENDPOINT_URL=http://localhost:9000
AWS_ALLOW_HTTP=true
AWS_S3_ALLOW_UNSAFE_RENAME=true