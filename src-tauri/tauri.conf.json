{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Emery",
  "version": "0.1.0",
  "identifier": "com.emery.app",
  "build": {
    "frontendDist": "http://localhost:3002",
    "devUrl": "http://localhost:3002"
  },
  "app": {
    "windows": [
      {
        "title": "Emery",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
