{
  "name": "emery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:prod": "pnpm build && pnpm start",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration:server": "npx tsx src/scripts/test-server-wrapper.ts start",
    "test:integration:dev": "vitest --config vitest.config.persistent.ts src/tests/integration/",
    "test:integration:file": "vitest --config vitest.config.persistent.ts --run",
    "test:integration:stop": "npx tsx src/scripts/test-server-wrapper.ts stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:agent-api": "node src/scripts/test-agent-execution-api.js",
    "grpc:generate": "pnpm run grpc:generate:js && pnpm run grpc:generate:python && pnpm run grpc:generate:ts",
    "grpc:generate:js": "/Users/lancekraakman/.nvm/versions/node/v22.13.0/bin/grpc_tools_node_protoc --js_out=import_style=commonjs,binary:src/lib/grpc/generated --grpc_out=grpc_js:src/lib/grpc/generated --plugin=protoc-gen-grpc=/Users/lancekraakman/.nvm/versions/node/v22.13.0/bin/grpc_tools_node_protoc_plugin -I proto proto/agent_worker.proto proto/table_service.proto",
    "grpc:generate:ts": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/lib/grpc/generated --ts_proto_opt=exportCommonSymbols,outputServices=grpc-js,esModuleInterop=true --proto_path=proto proto/table_service.proto proto/agent_worker.proto",
    "grpc:generate:python": "cd emery-agents && uv run python -m grpc_tools.protoc --pyi_out=src/emery_agents/grpc/generated --python_out=src/emery_agents/grpc/generated --grpc_python_out=src/emery_agents/grpc/generated -I ../proto ../proto/agent_worker.proto ../proto/table_service.proto",
    "worker:start": "cd emery-agents && uv run --env-file ../.env.local emery-worker",
    "scheduler:build": "mkdir -p dist && esbuild src/scripts/run-scheduler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/scheduler.js --external:pg-native --external:canvas --external:unpdf --external:@z-skip/protoc --external:llamaindex --external:@llamaindex/readers --external:@llamaindex/core --external:sharp --external:tiktoken --external:fsevents --external:@react-email/render --external:resend --external:mock-aws-s3 --external:aws-sdk --external:nock --external:@mapbox/node-pre-gyp --define:global=globalThis --sourcemap",
    "scheduler:start": "pnpm scheduler:build && node dist/scheduler.js",
    "scheduler:debug": "npx tsx src/scripts/debug-scheduler.ts",
    "test:grpc": "npx tsx src/scripts/test-grpc-e2e.ts",
    "test:nextjs-grpc": "npx tsx src/scripts/test-nextjs-grpc.ts",
    "test:scheduler": "npx tsx src/scripts/test-scheduler-system.ts",
    "seed:test": "npx tsx src/scripts/seed-test-data.ts",
    "seed:clean": "npx tsx src/scripts/seed-test-data.ts --clean",
    "seed:apps": "npx tsx src/drizzle/seeds/app-types.ts",
    "seed:tools": "npx tsx src/drizzle/seeds/tools.ts",
    "seed:all": "npm run seed:apps && npm run seed:tools",
    "test:agent-execution": "node src/scripts/test-agent-execution.js"
  },
