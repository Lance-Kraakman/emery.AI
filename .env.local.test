# Integration Test Database (different port from main)
DATABASE_URL=postgresql://postgres:integration_test_password@localhost:5436/emery_integration_test

# Environment settings for development
NODE_ENV=development

# NextAuth for Integration Tests  
NEXTAUTH_SECRET=integration-test-secret-L9v$gT2!xRm#Qz1W
NEXTAUTH_URL=http://localhost:3002
NEXT_PUBLIC_URL=http://localhost:3002

# S3 Configuration (MinIO for integration tests - external endpoint)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=emery-files
AWS_ENDPOINT_URL=http://localhost:9005
S3_FORCE_PATH_STYLE=true

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

