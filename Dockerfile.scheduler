# Dockerfile for Emery Event-Driven Scheduler
# Runs the compiled scheduler in a standalone container

FROM node:20-alpine

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    musl-dev \
    giflib-dev

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml ./

# Install pnpm and dependencies
RUN npm install -g pnpm
RUN pnpm install --prod

# Copy the compiled scheduler and environment files
COPY dist/scheduler.js ./
COPY .env.local .env

# Create non-root user
RUN addgroup -g 1001 -S scheduler && \
    adduser -S scheduler -u 1001

# Change ownership and switch to non-root user
RUN chown -R scheduler:scheduler /app
USER scheduler

# Environment variables
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "console.log('Scheduler health check')" || exit 1

# Expose no ports (scheduler runs internally)

# Run the compiled scheduler
CMD ["node", "scheduler.js"]